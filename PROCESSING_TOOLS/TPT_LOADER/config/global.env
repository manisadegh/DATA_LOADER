# ---------------------------------------------------------------------------
# Global Project Configuration - DATA_LOADER
# ---------------------------------------------------------------------------
# Base domain names for Teradata objects.
# The loader automatically prepends the environment code (${TDENV}) from .profile
# (e.g. TDENV=DEV0 => DEV0SIDFINSTG, TDENV=INT0 => INT0SIDFINSTG, TDENV=PRD0 => PRD0SIDFINSTG).

export DB_STG="SIDFINSTG"
export DB_WRK="SIDFINWRK"
export DB_TCH="SIDFINTCH"
