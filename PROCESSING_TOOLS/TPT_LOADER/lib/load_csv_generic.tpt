/***************************************************
 FDJ

 Finance domain - Oracle Fusion - Generic delimited file loader (TPT)

 Loads one BICC CSV extract (a single file or several file parts of
 the same extract) into an EXISTING Teradata staging table.

 The schema and the INSERT statement are generated at run time from
 the target table, so this script works for any table as long as the
 file columns match the table columns (same count, same order).

 All values below prefixed with @ are job variables generated by
 load_csv_generic.sh. Do not run this script directly.

 Steps:
   1. Truncate_Target       DELETE ALL on the target (replace mode only;
                            skipped in append mode via tbuild -s)
   2. Cleanup_Previous_Run  Drop log / error / work tables left by a
                            failed previous run (error 3807 ignored)
   3. Load_Data             Read the file(s) and load the target

 History

 Date         Auteur         Description
 07/10/2026   Mani Sadegh    Creation

****************************************************/

USING CHARACTER SET UTF8

DEFINE JOB LOAD_CSV_GENERIC
DESCRIPTION 'Generic load of BICC delimited file(s) into a Teradata staging table'
(

    /* -------------------------------------------------------------
       Schema generated at run time from the target table.
       DELIMITED => every column is generated as VARCHAR, sized from
       the table definition; the database performs the conversions
       (VARCHAR -> DATE / TIMESTAMP / DECIMAL / BIGINT ...) at load time.
       ------------------------------------------------------------- */
    DEFINE SCHEMA TGT_SCHEMA FROM TABLE DELIMITED @TargetTable;


    /* -------------------------------------------------------------
       DDL operator: truncate target, drop leftovers of a previous run
       ------------------------------------------------------------- */
    DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'DDL operator - prepare target table'
    TYPE DDL
    ATTRIBUTES
    (
        VARCHAR TdpId            = @TdpId,
        VARCHAR UserName         = @UserName,
        VARCHAR UserPassword     = @UserPassword,
        VARCHAR WorkingDatabase  = @WorkingDatabase,
        VARCHAR PrivateLogName   = @PrivateLogDDL,
        VARCHAR ARRAY ErrorList  = ['3807']          /* object does not exist */
    );


    /* -------------------------------------------------------------
       DataConnector producer: reads the delimited file(s)
       FileName may contain a wildcard to read all parts of one
       extract in a single job (DirectoryPath + FileName = directory scan).
       ------------------------------------------------------------- */
    DEFINE OPERATOR FILE_READER
    DESCRIPTION 'DataConnector producer - delimited BICC file(s)'
    TYPE DATACONNECTOR PRODUCER
    SCHEMA TGT_SCHEMA
    ATTRIBUTES
    (
        VARCHAR DirectoryPath        = @DirectoryPath,
        VARCHAR FileName             = @FileName,
        VARCHAR Format               = 'Delimited',
        VARCHAR OpenMode             = 'Read',
        VARCHAR TextDelimiter        = @TextDelimiter,

        /* BICC files: every field is enclosed in double quotes */
        VARCHAR QuotedData           = 'Optional',
        VARCHAR OpenQuoteMark        = '"',
        VARCHAR CloseQuoteMark       = '"',
        VARCHAR EscapeQuoteDelimiter = '"',        /* "" inside a quoted field = literal quote */

        VARCHAR NullColumns          = 'Y',        /* empty field -> NULL */
        INTEGER SkipRows             = @SkipRows,  /* header line */
        VARCHAR SkipRowsEveryFile    = @SkipRowsEveryFile, /* each file part carries its own header */

        /* Strict: a row with the wrong number of columns or an
           over-long value stops the job instead of being silently fixed */
        VARCHAR AcceptExcessColumns  = 'N',
        VARCHAR AcceptMissingColumns = 'Y',
        VARCHAR TruncateColumnData   = 'N',

        VARCHAR MultipleReaders      = @MultipleReaders,
        VARCHAR RecordErrorFileName  = @RecordErrorFile,
        VARCHAR PrivateLogName       = @PrivateLogReader
    );


    /* -------------------------------------------------------------
       Consumer 1 - Load operator (FastLoad protocol)
       Fastest. Requires an EMPTY target table => replace mode.
       ------------------------------------------------------------- */
    DEFINE OPERATOR LOAD_OPERATOR
    DESCRIPTION 'Load operator - replace mode (target emptied first)'
    TYPE LOAD
    SCHEMA *
    ATTRIBUTES
    (
        VARCHAR TdpId            = @TdpId,
        VARCHAR UserName         = @UserName,
        VARCHAR UserPassword     = @UserPassword,
        VARCHAR WorkingDatabase  = @WorkingDatabase,
        VARCHAR TargetTable      = @TargetTable,
        VARCHAR LogTable         = @LogTable,
        VARCHAR ErrorTable1      = @ErrorTable1,
        VARCHAR ErrorTable2      = @ErrorTable2,
        INTEGER ErrorLimit       = @ErrorLimit,
        VARCHAR DropLogTable     = 'Y',
        VARCHAR DropErrorTable   = 'Y',
        INTEGER MinSessions      = 1,
        INTEGER MaxSessions      = @MaxSessions,
        VARCHAR PrivateLogName   = @PrivateLogLoad
    );


    /* -------------------------------------------------------------
       Consumer 2 - Update operator (MultiLoad protocol)
       Target may already contain rows => append mode.
       ------------------------------------------------------------- */
    DEFINE OPERATOR UPDATE_OPERATOR
    DESCRIPTION 'Update operator - append mode (target may contain rows)'
    TYPE UPDATE
    SCHEMA *
    ATTRIBUTES
    (
        VARCHAR TdpId            = @TdpId,
        VARCHAR UserName         = @UserName,
        VARCHAR UserPassword     = @UserPassword,
        VARCHAR WorkingDatabase  = @WorkingDatabase,
        VARCHAR TargetTable      = @TargetTable,
        VARCHAR LogTable         = @LogTable,
        VARCHAR ErrorTable1      = @ErrorTable1,
        VARCHAR ErrorTable2      = @ErrorTable2,
        VARCHAR WorkTable        = @WorkTable,
        INTEGER ErrorLimit       = @ErrorLimit,
        VARCHAR DropLogTable     = 'Y',
        VARCHAR DropErrorTable   = 'Y',
        INTEGER MinSessions      = 1,
        INTEGER MaxSessions      = @MaxSessions,
        VARCHAR PrivateLogName   = @PrivateLogLoad
    );


    /* =============================================================
       STEP 1 - replace mode only (skipped with tbuild -s Cleanup_Previous_Run)
       ============================================================= */
    STEP Truncate_Target
    (
        APPLY ('DELETE FROM ' || @TargetTable || ' ALL;')
        TO OPERATOR (DDL_OPERATOR);
    );


    /* =============================================================
       STEP 2 - drop leftovers of a failed previous run
       ============================================================= */
    STEP Cleanup_Previous_Run
    (
        APPLY
            ('DROP TABLE ' || @LogTable    || ';'),
            ('DROP TABLE ' || @ErrorTable1 || ';'),
            ('DROP TABLE ' || @ErrorTable2 || ';'),
            ('DROP TABLE ' || @WorkTable   || ';')
        TO OPERATOR (DDL_OPERATOR);
    );


    /* =============================================================
       STEP 3 - load
       $INSERT generates "INSERT INTO <table> (col1..colN) VALUES (:col1..:colN)"
       from the target table definition.
       @ConsumerOperator is a double-quoted job variable resolving to
       LOAD_OPERATOR (replace) or UPDATE_OPERATOR (append).
       ============================================================= */
    STEP Load_Data
    (
        APPLY $INSERT @TargetTable
        TO OPERATOR (@ConsumerOperator [@LoadInstances])
        SELECT * FROM OPERATOR (FILE_READER [@ReaderInstances]);
    );

);
